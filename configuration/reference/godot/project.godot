; Răzeș desktop village. Open with Godot 4.7.2 stable.
config_version=5

[application]
config/name="Răzeș 3D"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Razes3D"
run/max_fps=30

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=700
window/stretch/mode="canvas_items"
window/subwindows/embed_subwindows=true

[rendering]
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=4096
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.14, 0.11, 1)
